*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --accent:#6366f1;
  --accent2:#8b5cf6;
  --bg:#f8f7ff;
  --bg2:#ede9fe;
  --bg3:#ddd6fe;
  --card:#ffffff;
  --text:#1e1b4b;
  --text2:#4c4980;
  --border:#e0d9ff;
  --shadow:rgba(99,102,241,0.12);
}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);transition:background .3s,color .3s;scroll-behavior:smooth;}

/* THEME SWITCHER */
.theme-bar{position:fixed;top:16px;right:16px;z-index:999;display:flex;gap:8px;background:var(--card);border:1px solid var(--border);border-radius:50px;padding:6px 10px;box-shadow:0 4px 20px var(--shadow);}
.theme-dot{width:22px;height:22px;border-radius:50%;cursor:pointer;border:2px solid transparent;transition:transform .2s,border-color .2s;}
.theme-dot:hover,.theme-dot.active{transform:scale(1.2);border-color:#fff;}
.t-indigo{background:linear-gradient(135deg,#6366f1,#8b5cf6);}
.t-rose{background:linear-gradient(135deg,#f43f5e,#fb7185);}
.t-teal{background:linear-gradient(135deg,#14b8a6,#06b6d4);}
.t-amber{background:linear-gradient(135deg,#f59e0b,#f97316);}
.t-green{background:linear-gradient(135deg,#22c55e,#16a34a);}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(248,247,255,0.85);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);padding:0 5%;}
.nav-inner{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;height:60px;}
.nav-logo{font-weight:800;font-size:1.1rem;background:linear-gradient(135deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.nav-links{display:flex;gap:28px;list-style:none;}
.nav-links a{text-decoration:none;color:var(--text2);font-size:.88rem;font-weight:500;transition:color .2s;}
.nav-links a:hover{color:var(--accent);}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;}
.hamburger span{width:24px;height:2px;background:var(--text);border-radius:2px;transition:.3s;}
.mobile-menu{display:none;flex-direction:column;gap:0;background:var(--card);border-top:1px solid var(--border);}
.mobile-menu a{padding:14px 5%;text-decoration:none;color:var(--text2);font-weight:500;border-bottom:1px solid var(--border);}

/* HERO */
.hero{min-height:100vh;display:flex;align-items:center;padding:80px 5% 40px;background:linear-gradient(160deg,var(--bg) 60%,var(--bg2) 100%);}
.hero-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;}
.hero-tag{display:inline-block;background:var(--bg3);color:var(--accent);font-size:.78rem;font-weight:600;padding:5px 14px;border-radius:50px;margin-bottom:16px;letter-spacing:.5px;}
.hero h1{font-size:3rem;font-weight:800;line-height:1.15;margin-bottom:16px;}
.hero h1 span{background:linear-gradient(135deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.hero p{color:var(--text2);font-size:1rem;line-height:1.7;margin-bottom:28px;}
.hero-btns{display:flex;gap:12px;flex-wrap:wrap;}
.btn{padding:11px 24px;border-radius:10px;font-size:.9rem;font-weight:600;cursor:pointer;text-decoration:none;transition:all .2s;border:none;}
.btn-primary{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;box-shadow:0 4px 16px var(--shadow);}
.btn-primary:hover{opacity:.9;transform:translateY(-1px);}
.btn-outline{background:transparent;color:var(--accent);border:2px solid var(--accent);}
.btn-outline:hover{background:var(--bg2);}
.hero-visual{display:flex;justify-content:center;}
.avatar-wrap{position:relative;width:280px;height:280px;}
.avatar-bg{position:absolute;inset:0;background:linear-gradient(135deg,var(--accent),var(--accent2));border-radius:40% 60% 55% 45%/50% 45% 55% 50%;animation:morph 6s ease-in-out infinite;opacity:.15;}
@keyframes morph{0%,100%{border-radius:40% 60% 55% 45%/50% 45% 55% 50%;}50%{border-radius:55% 45% 40% 60%/45% 55% 50% 50%;}}
.avatar-inner{position:absolute;inset:20px;background:linear-gradient(135deg,var(--bg2),var(--bg3));border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:5rem;box-shadow:0 8px 32px var(--shadow);}
.hero-stats{display:flex;gap:24px;margin-top:8px;}
.stat{text-align:center;}
.stat-num{font-size:1.6rem;font-weight:800;background:linear-gradient(135deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.stat-label{font-size:.72rem;color:var(--text2);font-weight:500;}

/* SECTIONS */
section{padding:70px 5%;}
.section-inner{max-width:1100px;margin:0 auto;}
.section-tag{font-size:.78rem;font-weight:700;color:var(--accent);letter-spacing:1px;text-transform:uppercase;margin-bottom:8px;}
.section-title{font-size:2rem;font-weight:800;margin-bottom:40px;}

/* EXPERIENCE */
.timeline{display:flex;flex-direction:column;gap:0;}
.tl-item{display:grid;grid-template-columns:160px 1fr;gap:0 28px;position:relative;}
.tl-item:not(:last-child)::after{content:'';position:absolute;left:159px;top:28px;bottom:-1px;width:2px;background:var(--bg3);}
.tl-date{text-align:right;padding-top:4px;font-size:.8rem;color:var(--text2);font-weight:500;line-height:1.4;}
.tl-dot{position:absolute;left:150px;top:8px;width:18px;height:18px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent2));box-shadow:0 0 0 4px var(--bg3);}
.tl-content{padding:0 0 32px 20px;}
.tl-title{font-size:1rem;font-weight:700;margin-bottom:2px;}
.tl-company{font-size:.85rem;color:var(--accent);font-weight:600;margin-bottom:10px;}
.tl-content ul{list-style:none;display:flex;flex-direction:column;gap:5px;}
.tl-content ul li{font-size:.85rem;color:var(--text2);padding-left:14px;position:relative;line-height:1.5;}
.tl-content ul li::before{content:'▸';position:absolute;left:0;color:var(--accent);font-size:.75rem;}

/* PROJECTS */
.projects-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:24px;}
.proj-card{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:28px;transition:transform .25s,box-shadow .25s;position:relative;overflow:hidden;}
.proj-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--accent),var(--accent2));}
.proj-card:hover{transform:translateY(-4px);box-shadow:0 12px 40px var(--shadow);}
.proj-badge{display:inline-block;font-size:.72rem;font-weight:700;padding:3px 10px;border-radius:50px;background:var(--bg2);color:var(--accent);margin-bottom:14px;}
.proj-title{font-size:1.1rem;font-weight:700;margin-bottom:6px;}
.proj-role{font-size:.8rem;color:var(--accent);font-weight:600;margin-bottom:10px;}
.proj-desc{font-size:.85rem;color:var(--text2);line-height:1.6;margin-bottom:16px;}
.proj-tags{display:flex;flex-wrap:wrap;gap:6px;}
.tag{font-size:.72rem;padding:3px 10px;border-radius:50px;background:var(--bg3);color:var(--text2);font-weight:500;}

/* SKILLS */
.skills-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;}
.skill-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:22px;transition:transform .2s,box-shadow .2s;}
.skill-card:hover{transform:translateY(-3px);box-shadow:0 8px 28px var(--shadow);}
.skill-cat{font-size:.75rem;font-weight:700;color:var(--accent);letter-spacing:.5px;text-transform:uppercase;margin-bottom:10px;}
.skill-items{display:flex;flex-wrap:wrap;gap:7px;}
.skill-pill{font-size:.78rem;padding:4px 11px;border-radius:50px;background:var(--bg2);color:var(--text);font-weight:500;border:1px solid var(--border);}

/* EDUCATION */
.edu-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;}
.edu-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:24px;display:flex;gap:16px;align-items:flex-start;transition:transform .2s,box-shadow .2s;}
.edu-card:hover{transform:translateY(-3px);box-shadow:0 8px 28px var(--shadow);}
.edu-icon{width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,var(--accent),var(--accent2));display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0;}
.edu-deg{font-size:.95rem;font-weight:700;margin-bottom:4px;}
.edu-school{font-size:.82rem;color:var(--accent);font-weight:600;margin-bottom:4px;}
.edu-year{font-size:.78rem;color:var(--text2);}

/* CONTACT */
#contact{background:linear-gradient(160deg,var(--bg2),var(--bg));}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start;}
.contact-info{display:flex;flex-direction:column;gap:16px;}
.contact-item{display:flex;align-items:center;gap:14px;background:var(--card);border:1px solid var(--border);border-radius:14px;padding:16px 20px;}
.contact-icon{width:40px;height:40px;border-radius:10px;background:var(--bg2);display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0;}
.contact-label{font-size:.75rem;color:var(--text2);font-weight:500;margin-bottom:2px;}
.contact-val{font-size:.88rem;font-weight:600;color:var(--text);}
.contact-val a{color:var(--accent);text-decoration:none;}
.contact-val a:hover{text-decoration:underline;}
.contact-cta{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:32px;}
.contact-cta h3{font-size:1.3rem;font-weight:700;margin-bottom:10px;}
.contact-cta p{color:var(--text2);font-size:.88rem;line-height:1.6;margin-bottom:20px;}

/* FOOTER */
footer{text-align:center;padding:24px;font-size:.82rem;color:var(--text2);border-top:1px solid var(--border);}

/* RESPONSIVE */
@media(max-width:768px){
  .hero-inner{grid-template-columns:1fr;gap:32px;text-align:center;}
  .hero h1{font-size:2rem;}
  .hero-visual{order:-1;}
  .avatar-wrap{width:180px;height:180px;}
  .hero-btns{justify-content:center;}
  .hero-stats{justify-content:center;}
  .tl-item{grid-template-columns:1fr;}
  .tl-date{text-align:left;padding-bottom:4px;}
  .tl-item::after{display:none;}
  .tl-dot{display:none;}
  .tl-content{padding:0 0 24px 0;}
  .contact-grid{grid-template-columns:1fr;}
  .nav-links{display:none;}
  .hamburger{display:flex;}
  .section-title{font-size:1.5rem;}
  .theme-bar{top:70px;}
}
</style>
