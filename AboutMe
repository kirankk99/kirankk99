<script>
const themes={
  indigo:{accent:'#6366f1',accent2:'#8b5cf6',bg:'#f8f7ff',bg2:'#ede9fe',bg3:'#ddd6fe',card:'#ffffff',text:'#1e1b4b',text2:'#4c4980',border:'#e0d9ff',shadow:'rgba(99,102,241,0.12)'},
  rose:  {accent:'#f43f5e',accent2:'#fb7185',bg:'#fff7f8',bg2:'#ffe4e6',bg3:'#fecdd3',card:'#ffffff',text:'#4c0519',text2:'#9f1239',border:'#fecdd3',shadow:'rgba(244,63,94,0.12)'},
  teal:  {accent:'#14b8a6',accent2:'#06b6d4',bg:'#f0fdfa',bg2:'#ccfbf1',bg3:'#99f6e4',card:'#ffffff',text:'#042f2e',text2:'#0f766e',border:'#99f6e4',shadow:'rgba(20,184,166,0.12)'},
  amber: {accent:'#f59e0b',accent2:'#f97316',bg:'#fffbeb',bg2:'#fef3c7',bg3:'#fde68a',card:'#ffffff',text:'#451a03',text2:'#92400e',border:'#fde68a',shadow:'rgba(245,158,11,0.12)'},
  green: {accent:'#22c55e',accent2:'#16a34a',bg:'#f0fdf4',bg2:'#dcfce7',bg3:'#bbf7d0',card:'#ffffff',text:'#052e16',text2:'#166534',border:'#bbf7d0',shadow:'rgba(34,197,94,0.12)'},
};

function setTheme(name){
  const t=themes[name];
  const r=document.documentElement.style;
  r.setProperty('--accent',t.accent);
  r.setProperty('--accent2',t.accent2);
  r.setProperty('--bg',t.bg);
  r.setProperty('--bg2',t.bg2);
  r.setProperty('--bg3',t.bg3);
  r.setProperty('--card',t.card);
  r.setProperty('--text',t.text);
  r.setProperty('--text2',t.text2);
  r.setProperty('--border',t.border);
  r.setProperty('--shadow',t.shadow);
  document.querySelectorAll('.theme-dot').forEach(d=>d.classList.remove('active'));
  document.querySelector('.t-'+name).classList.add('active');
}

function toggleMenu(){
  const m=document.getElementById('mobileMenu');
  m.style.display=m.style.display==='flex'?'none':'flex';
}

// smooth active nav highlight on scroll
const sections=document.querySelectorAll('section[id]');
window.addEventListener('scroll',()=>{
  let cur='';
  sections.forEach(s=>{if(window.scrollY>=s.offsetTop-80)cur=s.id;});
  document.querySelectorAll('.nav-links a').forEach(a=>{
    a.style.color=a.getAttribute('href')==='#'+cur?'var(--accent)':'';
  });
});
</script>
